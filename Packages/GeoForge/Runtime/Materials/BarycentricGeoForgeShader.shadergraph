    "m_ObjectId": "427cab25bfd84db7b3a7c2d92cc691c0",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "BarycentricSolver (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -367.9998779296875,
            "y": 351.0,
            "width": 272.9998779296875,
            "height": 285.99993896484377
        }
    },
    "m_Slots": [
        {
            "m_Id": "896cefe8b6db4585b33525e9c0624d6e"
        },
        {
            "m_Id": "706d34d17a9e46568efb3e861a6de475"
        },
        {
            "m_Id": "03fe371ed893451ebe9dbe2e4c9b30ff"
        },
        {
            "m_Id": "131450101fa349adaf7b13ec0e094922"
        },
        {
            "m_Id": "005ecb81cb4848328be0a951cf024538"
        },
        {
            "m_Id": "58c9ea9012854510b3a45406bbd39aed"
        },
        {
            "m_Id": "69593f5f4e53429fa4899c684ed1ece7"
        },
        {
            "m_Id": "c97901a92d994f6da61a184c48078ad6"
        },
        {
            "m_Id": "56f4c51a5d584684a98e977924a964ef"
        },
        {
            "m_Id": "0f82949d1dc945919c6d89812221a507"
        },
        {
            "m_Id": "5c9d545d094b49dbabf7b947a3cd4523"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BarycentricSolver",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float weightA = U;\r\nfloat weightB = V;\r\nfloat weightC = W;\r\n\r\nconst float roundness = 2.0; // 1.0 = sharp straight line (what we just built), higher = rounder\r\n\r\nif (MaterialIndexA == MaterialIndexB && MaterialIndexA == MaterialIndexC) {\r\n    // all three share one material - no merge needed\r\n}\r\nelse if (MaterialIndexA == MaterialIndexB) {\r\n    float merged = pow(pow(U, roundness) + pow(V, roundness), 1.0 / roundness);\r\n    weightA = weightB = merged;\r\n}\r\nelse if (MaterialIndexA == MaterialIndexC) {\r\n    float merged = pow(pow(U, roundness) + pow(W, roundness), 1.0 / roundness);\r\n    weightA = weightC = merged;\r\n}\r\nelse if (MaterialIndexB == MaterialIndexC) {\r\n    float merged = pow(pow(V, roundness) + pow(W, roundness), 1.0 / roundness);\r\n    weightB = weightC = merged;\r\n}\r\n\r\nif (weightA >= weightB && weightA >= weightC)\r\n{\r\n    FinalMaterialIndex = MaterialIndexA;\r\n    FinalIsMature = IsMatureA;\r\n}\r\nelse if (weightB >= weightC)\r\n{\r\n    FinalMaterialIndex = MaterialIndexB;\r\n    FinalIsMature = IsMatureB;\r\n}\r\nelse\r\n{\r\n    FinalMaterialIndex = MaterialIndexC;\r\n    FinalIsMature = IsMatureC;\r\n}"
}

